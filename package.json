{
  "name": "@bryandev/expo-mapbox-navigation",
  "version": "1.7.15",
  "description": "Expo module for Mapbox's Navigation SDK",
  "readmeFilename": "README.md",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node scripts/generateNavigationStrings.cjs && expo-module build",
    "generate:localization": "node scripts/generateNavigationStrings.cjs",
    "check:localization": "node scripts/generateNavigationStrings.cjs --check",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "prepare": "node scripts/generateNavigationStrings.cjs && expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "mapbox",
    "navigation",
    "expo-mapbox-navigation",
    "ExpoMapboxNavigation"
  ],
  "repository": "https://github.com/BryanQuezada1910/expo-mapbox-navigation",
  "bugs": {
    "url": "https://github.com/BryanQuezada1910/expo-mapbox-navigation/issues"
  },
  "author": "BryanQuezada1910 <[EMAIL_ADDRESS]> (https://github.com/BryanQuezada1910)",
  "license": "MIT",
  "homepage": "https://github.com/BryanQuezada1910/expo-mapbox-navigation#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^18.0.25",
    "expo-module-scripts": "^3.5.2",
    "expo-modules-core": "~2.5.0",
    "@expo/config-plugins": "~8.0.10"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*",
    "@rnmapbox/maps": "*"
  }
}
